{
  "manifest_version": 3,
  "name": "Netflix Autoplay Off",
  "description": "__MSG_extDescription__",
  "version": "2.0.0",
  "default_locale": "ja",
  "minimum_chrome_version": "116",
  "homepage_url": "https://github.com/kai-rin/netflix-autoplay-off",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Netflix Autoplay Off",
    "default_popup": "popup.html"
  },
  "permissions": [
    "contextMenus",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["inject.js", "player.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
